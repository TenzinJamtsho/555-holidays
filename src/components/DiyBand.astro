---
/* "Design your own" teaser linking to the trip planner */
import { U } from '../lib/site.js';
---
<div class="diy rv">
  <div>
    <span class="label">Or design your own</span>
    <h3>Build your journey in two minutes</h3>
    <p>Choose your dates, pace, valleys and the moments you'd love. We'll show you a realistic plan as you go (how many days, how much driving) and send it to our team in Thimphu.</p>
    <a class="pill" href={U.plan} style="margin-top:20px"><span>Design your journey</span><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M7 17 17 7M8 7h9v9"/></svg></i></a>
  </div>
  <ol aria-label="How the planner works">
    <li>When and how long</li>
    <li>Your pace</li>
    <li>The valleys you'd like to see</li>
    <li>Moments to live</li>
    <li>Where you'd like to stay</li>
  </ol>
</div>
