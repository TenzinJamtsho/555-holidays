---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { U } from '../lib/site.js';
---
<Base title="Page not found | 555 Holidays" description="This page could not be found.">
<PageHero img="/images/why.jpg" short crumbs={[['Not found']]} title="Lost in the mountains?" sub="This page doesn't exist, or it has moved." />
<main id="main">
  <section style="padding-top:clamp(50px,5vw,80px)"><div class="wrap narrow" style="text-align:center">
    <p class="intro-p" style="margin:0 auto 24px">Try one of these instead:</p>
    <div class="cta-btns" style="justify-content:center">
      <a class="btn btn-dark" href="/">Home</a><a class="btn btn-outline-dark" href={U.tours}>Tours</a>
      <a class="btn btn-outline-dark" href={U.festivals}>Festivals</a><a class="btn btn-outline-dark" href={U.contact}>Contact</a>
    </div>
  </div></section>
</main>
</Base>
