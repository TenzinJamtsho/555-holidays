---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { ph, crumbsLd } from '../lib/site.js';
const D = [["Paro","Thimphu","65 km","1 hr*"],["Paro","Haa","65 km","1.5–2 hrs"],["Thimphu","Haa","115 km","3–4 hrs"],["Thimphu","Phuentsholing","176 km","4 hrs*"],["Thimphu","Wangdue Phodrang","70 km","3 hrs*"],["Thimphu","Punakha","77 km","3 hrs*"],["Thimphu","Phobjikha (Gangtey)","135 km","5.5–6 hrs"],["Punakha","Wangdue Phodrang","13 km","45 min*"],["Punakha","Gangtey (Phobjikha)","78 km","3 hrs"],["Punakha","Bumthang","212 km","8 hrs"],["Gangtey","Wangdue Phodrang","65 km","2.5–3 hrs"],["Gangtey","Trongsa","120 km","4.5–5 hrs"],["Bumthang","Gangtey","188 km","5–6 hrs"],["Trongsa","Wangdue Phodrang","129 km","4.5 hrs*"],["Trongsa","Punakha","142 km","6 hrs"],["Trongsa","Bumthang","68 km","2 hrs*"],["Bumthang","Mongar","198 km","7 hrs*"],["Mongar","Lhuentse","76 km","3 hrs*"],["Lhuentse","Trashigang","–","3.5 hrs*"],["Mongar","Trashigang","91 km","3–4 hrs"],["Trashigang","Chorten Kora","52 km","2 hrs"],["Trashigang","Trashiyangtse","55 km","3 hrs*"],["Trashigang","Samdrup Jongkhar","180 km","3 hrs* [CHECK: seems short]"],["Samdrup Jongkhar","Guwahati (Assam)","110 km","3 hrs"],["Samdrup Jongkhar","Phuentsholing","400 km","10 hrs"],["Phuentsholing","Bagdogra","165 km","4 hrs*"],["Phuentsholing","Siliguri","155 km","4 hrs"],["Phuentsholing","Darjeeling","200 km","6 hrs"],["Phuentsholing","Kalimpong","185 km","5 hrs"],["Phuentsholing","Gangtok (Sikkim)","220 km","7 hrs"],["Phuentsholing","Dooars (Chalsa)","110 km","2.5 hrs"]];
---
<Base
  title="Bhutan Travel Guide 2027: Visa, SDF, Costs, Best Time & Tips | 555 Holidays"
  description="Everything you need to plan a trip to Bhutan: visa and entry rules, the Sustainable Development Fee (USD 100, Nu. 1,200 for Indians), getting there, best time to visit, money, health, etiquette and drive times."
  image="/images/contact.jpg"
  jsonld={[crumbsLd([['Home', '/'], ['Travel info', '/travel-info/']])]}
>
<PageHero img="/images/contact.jpg" alt="Rinpung Dzong above the green Paro valley under dramatic clouds" page="info" crumbs={[['Travel info']]}
  title="Bhutan travel guide"
  sub="Everything we'd tell a friend planning their first trip to Bhutan: honest, practical, and kept up to date by our team in Thimphu." />

<main id="main">
<section style="padding-top:clamp(50px,5vw,80px)">
  <div class="wrap">
    <div class="info-layout">
      <nav class="toc" aria-label="On this page">
        <a href="#visa">Visa &amp; entry</a>
        <a href="#costs">Costs &amp; the SDF</a>
        <a href="#getting-there">Getting there</a>
        <a href="#when">When to go</a>
        <a href="#money">Money &amp; phones</a>
        <a href="#health">Health &amp; insurance</a>
        <a href="#etiquette">Etiquette &amp; dress</a>
        <a href="#responsible">Travel responsibly</a>
        <a href="#distances">Road distances</a>
        <a href="#links">Useful links</a>
      </nav>

      <div class="prose">
        <!-- VISA -->
        <div class="info-sec rv" id="visa">
          <h2>Visa &amp; entry</h2>
          <div class="callout blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.5"/></svg>
            <div>This section follows the Department of Tourism's official FAQ (<a href="https://bhutan.travel/faqs" target="_blank" rel="noopener">bhutan.travel/faqs</a>). Rules can change, so we always confirm the latest requirements with you before you book.</div></div>
          <h3 style="font-size:18px;margin:14px 0 8px">Indian nationals</h3>
          <p>No visa is needed: you apply for an entry permit instead, using a valid Indian passport or Voter ID card. Children under 18 can travel with a passport or birth certificate, accompanied by a legal guardian.</p>
          <h3 style="font-size:18px;margin:14px 0 8px">All other nationalities</h3>
          <p>Everyone else needs a visa. Bangladeshi and Maldivian nationals can apply in advance or on arrival; all others apply before travelling. Here's how it works with us:</p>
          <ol>
            <li>Choose your journey with us.</li>
            <li>Send us a scan of your passport photo page.</li>
            <li>We submit your application on the official portal (<a href="https://immi.gov.bt" target="_blank" rel="noopener">immi.gov.bt</a>), together with the one-off USD 40 processing fee and your Sustainable Development Fee.</li>
            <li>A correctly completed application is processed within five days.</li>
            <li>Bring your visa clearance letter; the visa allows a stay of up to 90 days.</li>
          </ol>
          <h3 style="font-size:18px;margin:14px 0 8px">Do I need a tour operator or a guide?</h3>
          <p>Since Bhutan reopened on 23 September 2022 you don't have to book through a tour operator. However, a licensed guide must accompany you at all times and is required to enter dzongs and monuments, and all treks must be done with an accredited operator or guide. Route permits are no longer needed for most visitors travelling with a certified guide.</p>
        </div>

        <!-- COSTS -->
        <div class="info-sec rv" id="costs">
          <h2>Costs &amp; the Sustainable Development Fee</h2>
          <p>Bhutan's tourism policy is "High Value, Low Impact": visitor numbers have been managed since tourism opened in 1974 to keep it environmentally friendly, culturally respectful and economically fair.</p>
          <h3 style="font-size:18px;margin:14px 0 8px">The Sustainable Development Fee (SDF)</h3>
          <p>A government fee, charged for every night of your stay. It funds conservation, upgrades infrastructure, and creates long-term, sustainable opportunities for Bhutanese people.</p>
          <div class="tbl-wrap"><table>
            <thead><tr><th>Traveller</th><th>Most nationalities</th><th>Indian nationals</th></tr></thead>
            <tbody><tr><td>Adult</td><td>USD 100</td><td>Nu. 1,200</td></tr><tr><td>Child, 6 to under 12</td><td>USD 50</td><td>Nu. 600</td></tr><tr><td>Child, under 6</td><td>Free</td><td>Free</td></tr></tbody>
          </table></div>
          <p>The SDF is refunded (less bank charges) for cancelled or shortened trips. Until August 2027, guests staying no more than 24 hours in the border towns of Samtse, Phuentsholing, Gelephu or Samdrup Jongkhar, without going beyond the designated zones, pay no SDF.</p>
          <h3 style="font-size:18px;margin:14px 0 8px">What a day with us costs</h3>
          <p>Most trips run about <mark class="ph">[USD ___–___]</mark> per person per day. That includes the SDF, hotels, all meals, your licensed guide, and a private vehicle with driver. You'll receive an exact, itemised quote before you commit to anything.</p>
          <div class="grid2">
            <div class="mini"><h3>Included</h3><p>SDF · all accommodation · all meals &amp; mineral water · licensed English-speaking guide · private driver &amp; vehicle · visa processing</p></div>
            <div class="mini"><h3>Not included</h3><p>Airfare · visa fee (USD 40) · drinks &amp; alcohol · museum/monument entry fees · travel insurance · tips, laundry, phone, massage &amp; souvenirs</p></div>
          </div>
          <h3 style="font-size:18px;margin:22px 0 8px">Payment</h3>
          <p>The visa fee and SDF are paid when the visa application is submitted. For the rest of your trip we'll explain our payment terms with your quote. <mark class="ph">[CONFIRM YOUR DEPOSIT &amp; PAYMENT TERMS]</mark> If you pay by international card, let your bank know first: some banks block payments to Bhutan.</p>
        </div>

        <!-- GETTING THERE -->
        <div class="info-sec rv" id="getting-there">
          <h2>Getting there</h2>
          <h3 style="font-size:18px;margin:14px 0 8px">By air</h3>
          <p>Most guests arrive at Paro International Airport; Gelephu, in the south, is also listed as an international airport, and there are domestic airports at Bumthang and Yonphula. <strong>Drukair</strong>, the national carrier, flies to and from cities including Bangkok, Kathmandu, Delhi, Kolkata, Bodhgaya and Bagdogra; <strong>Bhutan Airlines</strong> is the private carrier. <mark class="ph">[CONFIRM CURRENT ROUTES]</mark></p>
          <p>All flights use Visual Flight Rules, so there are no night flights or flights in poor visibility. Weather delays are common: book flexible tickets and allow at least 24 hours for onward connections. On a clear day you'll see 8 of the world's 10 highest peaks, including Everest (8,848 m) and Kanchenjunga (8,586 m). <a href="/journal/flying-into-paro/">Read about the flight →</a></p>
          <h3 style="font-size:18px;margin:14px 0 8px">By road</h3>
          <p>There are four land border crossings, each with a visitor information centre, at Samtse, Phuentsholing, Gelephu and Samdrup Jongkhar. Phuentsholing, on the border with West Bengal, is the busiest; Samdrup Jongkhar in the east is about 3 hours from Guwahati (Assam). A guide is required to travel beyond the border towns.</p>
        </div>

        <!-- WHEN -->
        <div class="info-sec rv" id="when">
          <h2>When to go</h2>
          <div class="tbl-wrap"><table>
            <thead><tr><th>Season</th><th>Months</th><th>What to expect</th></tr></thead>
            <tbody>
              <tr><td>Spring</td><td>Mar – mid-Apr</td><td>Nature in full bloom: rhododendrons, Paro Tshechu</td></tr>
              <tr><td>Monsoon</td><td>Late Jun – Sep</td><td>Green and quiet; mainly affects the south, and landslides can disrupt roads</td></tr>
              <tr><td>Autumn</td><td>Late Sep – Nov</td><td>Bright, sunny days, festival season, best trekking</td></tr>
              <tr><td>Winter</td><td>Late Nov – Mar</td><td>Crisp and clear, with snow above 3,000 m; black-necked cranes in Phobjikha</td></tr>
            </tbody>
          </table></div>
          <p>Bhutan is a year-round destination. More than 250 festivals take place each year, following the lunar calendar. <a href="/festivals/">See the festival calendar →</a></p>
        </div>

        <!-- MONEY -->
        <div class="info-sec rv" id="money">
          <h2>Money &amp; phones</h2>
          <div class="grid2">
            <div class="mini"><h3>Currency</h3><p>The Ngultrum (Nu.) is pegged 1:1 to the Indian Rupee. Cash is preferred, and US dollars and Indian rupees are widely accepted. You can bring up to USD 10,000 in cash.</p></div>
            <div class="mini"><h3>Cards &amp; apps</h3><p>ATMs and banks accept Visa and Mastercard, and cards work well in towns but may not be reliable in rural areas. The goBoB (Bank of Bhutan) and MyPay (Bhutan National Bank) apps can be linked to international cards. Change money at Paro airport, banks or larger hotels.</p></div>
            <div class="mini"><h3>Phones &amp; data</h3><p>Visitor SIM cards from TashiCell and Bhutan Telecom give reliable mobile data across the country. Buy one at the airport or a phone shop in town, and top up with your digital wallet app.</p></div>
            <div class="mini"><h3>Tipping</h3><p>Optional, and entirely up to you based on the service you receive.</p></div>
          </div>
        </div>

        <!-- HEALTH -->
        <div class="info-sec rv" id="health">
          <h2>Health &amp; insurance</h2>
          <p>No vaccinations are generally required, except yellow fever or cholera if you're arriving from an affected area. Travel insurance has not been mandatory since 23 April 2024, but we strongly recommend a policy covering medical emergencies and lost baggage, and, if you're trekking, high-altitude evacuation. <mark class="ph">[ADD ALTITUDE ADVICE FROM YOUR TREKKING TEAM]</mark></p>
          <p>Bhutan is a very safe country for travellers, including solo and women travellers. Your guide and driver are with you throughout.</p>
          <div class="tbl-wrap"><table>
            <thead><tr><th>Emergency &amp; help</th><th>Number</th></tr></thead>
            <tbody><tr><td>Ambulance</td><td>112</td></tr><tr><td>Police</td><td>113</td></tr><tr><td>Fire</td><td>110</td></tr><tr><td>Department of Tourism</td><td>+975 17661974</td></tr><tr><td>Free host service (Department of Tourism)</td><td><a href="mailto:hosts@tourism.gov.bt">hosts@tourism.gov.bt</a></td></tr></tbody>
          </table></div>
        </div>

        <!-- ETIQUETTE -->
        <div class="info-sec rv" id="etiquette">
          <h2>Etiquette &amp; dress code</h2>
          <ul class="ticks">
            <li>There's no formal dress code, but at religious sites smart-casual clothing that covers you from shoulders to knees is appreciated. Remove hats, and speak softly.</li>
            <li>Photography is not permitted inside temples or of people practising their religion. Your guide will tell you where it's fine.</li>
            <li>Most monuments are free; some charge a fee (50% off for under-18s, free for children aged five and under). They're generally open 9 am to 5 pm.</li>
            <li>Drones need a permit arranged in advance, and exporting antiques is restricted.</li>
            <li>Walk clockwise around chortens, prayer wheels and temples.</li>
            <li>Ask before photographing people, especially monks and festival dancers.</li>
            <li>At festivals, never walk across the dance ground.</li>
          </ul>
        </div>

        <!-- RESPONSIBLE -->
        <div class="info-sec rv" id="responsible">
          <h2>Travel responsibly</h2>
          <ul class="ticks">
            <li>Choose environmentally certified hotels and lodges.</li>
            <li>Avoid single-use plastic: bring a reusable bottle, bags and containers.</li>
            <li>Keep your distance from wildlife and stay on marked trails.</li>
            <li>Buy local products, eat at local restaurants and travel with local guides.</li>
            <li>Respect customs and religious sites.</li>
          </ul>
        </div>

        <!-- DISTANCES -->
        <div class="info-sec rv" id="distances">
          <h2>Road distances &amp; drive times</h2>
          <p>Mountain roads are slow and beautiful. Road widening has shortened several journeys; times marked * follow the Department of Tourism's current guest guide, and the rest are approximate.</p>
          <div class="tbl-wrap"><table>
            <thead><tr><th>From</th><th>To</th><th>Distance</th><th>Drive</th></tr></thead>
            <tbody>{D.map(r => <tr>{r.map(c => <td set:html={ph(c)} />)}</tr>)}</tbody>
          </table></div>
        </div>

        <!-- LINKS -->
        <div class="info-sec rv" id="links">
          <h2>Useful links</h2>
          <ul>
            <li><a href="https://www.bhutan.travel" target="_blank" rel="noopener">Department of Tourism, Bhutan (bhutan.travel)</a></li>
            <li><a href="https://www.abto.org.bt" target="_blank" rel="noopener">Association of Bhutanese Tour Operators (ABTO)</a></li>
            <li><a href="https://www.gab.org.bt" target="_blank" rel="noopener">Guide Association of Bhutan</a></li>
            <li><a href="https://www.drukair.com.bt" target="_blank" rel="noopener">Drukair</a></li>
            <li><a href="https://www.bhutanairlines.bt" target="_blank" rel="noopener">Bhutan Airlines</a></li>
          </ul>
          <p>Still have questions? <a href="/faq/">Read the full FAQ</a> or <a href="/contact/">ask us directly</a>.</p>
        </div>
      </div>
    </div>
  </div>
</section>
</main>
</Base>
